# Copy to .env (gitignored) and fill in. Used by scripts/, not committed.

# Datadog API key (ingest-only). Loaded into SSM by scripts/set-datadog-key.sh.
datadog_api_key=

# Your Datadog site, if not US1. Set the matching Terraform var datadog_site:
#   US1=datadoghq.com  US3=us3.datadoghq.com  US5=us5.datadoghq.com
#   EU=datadoghq.eu    AP1=ap1.datadoghq.com
# datadog_site=datadoghq.com

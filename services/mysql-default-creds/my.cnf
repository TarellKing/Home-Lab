# =============================================================================
# MySQL honeypot config.
# =============================================================================
# The weakness here is operational (default root/root creds, set via the
# container's environment). This file adds full statement capture so every
# query an attacker runs is recorded to a file the CloudWatch agent tails.

[mysqld]
# Record every statement. Noisy on a real server; perfect on a honeypot.
general_log      = 1
general_log_file = /var/log/mysql/general.log

log_error = /var/log/mysql/error.log

# Listen on all interfaces so the edge tier can reach it.
bind-address = 0.0.0.0
